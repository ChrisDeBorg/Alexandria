@page "/entities/create"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Alexandria.Application.Abstractions
@using Alexandria.Application.Entities
@using Alexandria.Application.EntityTypes

@inject IEntityService EntityService
@inject IEntityTypeService EntityTypeService
@inject NavigationManager Navigation

<PageTitle>Neue Entity – Alexandria</PageTitle>

<h1>Neue Entity</h1>

<p class="text-muted">Eine neue Entität in Alexandria anlegen.</p>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p>EntityTypes werden geladen ...</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <InputText id="name"
                       class="form-control"
                       @bind-Value="model.Name" />
            <ValidationMessage For="@(() => model.Name)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="description">
                Beschreibung
            </label>
            <InputTextArea id="description"
                           class="form-control"
                           rows="4"
                           @bind-Value="model.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="entityType">
                EntityType
            </label>

            <InputSelect id="entityType"
                         class="form-select"
                         @bind-Value="model.EntityTypeId">
                <option value="@Guid.Empty">
                    -- EntityType auswählen --
                </option>

                @foreach (var entityType in entityTypes)
                {
                    <option value="@entityType.Id">
                        @GetEntityTypeLabel(entityType)
                    </option>
                }
            </InputSelect>

            @if (entityTypes.Count == 0)
            {
                <div class="form-text">
                    Es existieren noch keine EntityTypes.
                    Bitte lege zuerst einen neuen Typ an.
                </div>
            }
        </div>

        <button type="button"
                class="btn btn-outline-primary mb-3"
                @onclick="ToggleNewEntityType">
            @(showNewEntityType
                ? "Neuanlage abbrechen"
                : "Neuen EntityType anlegen")
        </button>

        @if (showNewEntityType)
        {
            <div class="card card-body mb-3">
                <h5>Neuen EntityType anlegen</h5>

                <div class="mb-3">
                    <label class="form-label" for="typeName">
                        Name *
                    </label>
                    <InputText id="typeName"
                               class="form-control"
                               @bind-Value="newEntityTypeName" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="typeDisplayName">
                        DisplayName
                    </label>
                    <InputText id="typeDisplayName"
                               class="form-control"
                               @bind-Value="newEntityTypeDisplayName" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="typeDescription">
                        Beschreibung
                    </label>
                    <InputTextArea id="typeDescription"
                                   class="form-control"
                                   rows="3"
                                   @bind-Value="newEntityTypeDescription" />
                </div>

                <button type="button"
                        class="btn btn-success"
                        disabled="@isCreatingEntityType"
                        @onclick="CreateEntityTypeAsync">
                    @(isCreatingEntityType
                        ? "Wird angelegt ..."
                        : "EntityType anlegen")
                </button>
            </div>
        }

        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">
            @(isSaving ? "Wird gespeichert ..." : "Speichern")
        </button>

        <button type="button"
                class="btn btn-outline-secondary ms-2"
                @onclick="Cancel">
            Abbrechen
        </button>
    </EditForm>
}

@code {
    private readonly EntityFormModel model = new();

    private List<EntityTypeDto> entityTypes = [];

    private bool isLoading = true;
    private bool isSaving;
    private bool isCreatingEntityType;
    private bool showNewEntityType;

    private string? errorMessage;

    private string newEntityTypeName = string.Empty;
    private string? newEntityTypeDisplayName;
    private string? newEntityTypeDescription;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadEntityTypesAsync();
        }
        catch (Exception)
        {
            errorMessage = "Die EntityTypes konnten nicht geladen werden.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadEntityTypesAsync()
    {
        var result = await EntityTypeService.GetAllAsync();

        entityTypes = result.ToList();
    }

    private static string GetEntityTypeLabel(EntityTypeDto entityType)
    {
        return string.IsNullOrWhiteSpace(entityType.DisplayName)
            ? entityType.Name
            : entityType.DisplayName;
    }

    private void ToggleNewEntityType()
    {
        showNewEntityType = !showNewEntityType;
        errorMessage = null;
    }

    private async Task CreateEntityTypeAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newEntityTypeName))
        {
            errorMessage = "Bitte einen Namen für den EntityType eingeben.";
            return;
        }

        isCreatingEntityType = true;

        try
        {
            var created = await EntityTypeService.CreateAsync(
                new CreateEntityTypeRequest(
                    newEntityTypeName,
                    newEntityTypeDisplayName,
                    newEntityTypeDescription));

            await LoadEntityTypesAsync();

            model.EntityTypeId = created.Id;

            newEntityTypeName = string.Empty;
            newEntityTypeDisplayName = null;
            newEntityTypeDescription = null;

            showNewEntityType = false;
        }
        catch (Exception)
        {
            errorMessage = "Der EntityType konnte nicht angelegt werden. "
                + "Möglicherweise existiert der Name bereits.";
        }
        finally
        {
            isCreatingEntityType = false;
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (model.EntityTypeId == Guid.Empty)
        {
            errorMessage = "Bitte einen EntityType auswählen.";
            return;
        }

        isSaving = true;

        try
        {
            await EntityService.CreateAsync(
                new CreateEntityRequest(
                    model.Name,
                    model.Description,
                    model.EntityTypeId));

            Navigation.NavigateTo("/entities");
        }
        catch (Exception)
        {
            errorMessage = "Die Entity konnte nicht gespeichert werden.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/entities");
    }

    private sealed class EntityFormModel
    {
        [Required(ErrorMessage = "Bitte einen Namen eingeben.")]
        [StringLength(250)]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public Guid EntityTypeId { get; set; }
    }
}
